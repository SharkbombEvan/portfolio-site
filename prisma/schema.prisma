generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  summary    String
  content    String?
  tech       String[] @default([])
  coverImage String?
  demoUrl    String?
  repoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
