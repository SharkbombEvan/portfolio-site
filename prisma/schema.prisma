generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Project {
  id         String         @id @default(cuid())
  title      String
  slug       String         @unique
  summary    String
  content    String?

  // Sharkbomb Audio side overrides: product-brief copy shown instead of
  // summary/content when a project is viewed in audio mode. Empty = fall back.
  audioSummary String?
  audioContent String?
  tech       String[]       @default([])
  coverImage String?
  demoUrl    String?
  repoUrl    String?
  shopUrl    String?
  price      String?
  isProduct  Boolean        @default(false)

  // Portfolio organization
  areas         String[] @default([])
  featured      Boolean  @default(false)
  featuredOrder Int?
  audioFeatured Boolean  @default(false)

  // Case-study details
  role       String?
  year       String?
  context    String?
  highlights String[]       @default([])

  images     ProjectImage[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ProjectImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  order     Int      @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@unique([projectId, order])
}